   "source": [
    "# Create two matrices\n",
    "import numpy as np\n",
    "matrix1 = np.array([\n",
    "    [1, 2, 3],\n",
    "    [4, 5, 6]\n",
    "])\n",
    "\n",
    "matrix2 = np.array([\n",
    "    [7, 8, 9],\n",
    "    [10, 11, 12]\n",
    "])\n",
    "\n",
    "# Add the two matrices using NumPy\n",
    "result = matrix1 + matrix2\n",
    "\n",
    "# Display the result\n",
    "print(\"Resultant Matrix:\")\n",
    "print(result)\n"
   ]
  }
 ],
